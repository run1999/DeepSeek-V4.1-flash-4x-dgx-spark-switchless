diff --git a/src/graph/ringpeer.cc b/src/graph/ringpeer.cc
new file mode 100644
index 0000000..d55bd4c
--- /dev/null
+++ b/src/graph/ringpeer.cc
@@ -0,0 +1,179 @@
+/*************************************************************************
+ * SPDX-FileCopyrightText: Copyright (c) 2016-2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+ * SPDX-License-Identifier: MIT
+ *
+ * Switchless-ring support (original implementation on top of
+ * NVIDIA NCCL v2.30.7-1; see IMPLEMENTATION.md at the repo root).
+ *
+ * Purpose: 4-node switchless ring fabrics (each node directly cabled to its
+ * two ring neighbours only, two direct links per edge). Stock NCCL assumes a
+ * switched fabric where every NIC can reach every rank, which (a) makes
+ * ncclCommInitRank hang on QP connect timeouts towards non-adjacent ranks
+ * (tree/collnet/PAT binomial channels all require rank<->rank+2 links) and
+ * (b) leaves the second direct link of each edge idle.
+ *
+ * Environment variable (SR-3, unset => completely bypassed):
+ *   NCCL_RING_EDGE_DEVS="pair=<dev>,<dev>;cross=<dev>,<dev>"
+ * Example (4-node ring; every node sets the SAME value):
+ *   NCCL_RING_EDGE_DEVS="pair=1,3;cross=0,2"
+ *
+ * Semantics:
+ *   - The value is a deployment-wide edge rule that contains no rank id, so
+ *     one identical value fits all nodes (deployment pipelines can inject
+ *     the same env on every host). The library derives the edge class from
+ *     (myRank, peerRank) itself. Over the ring order 0-1-2-3-0 there are
+ *     two edge classes:
+ *       "pair"  edges: rank pairs {(0,1),(2,3)}
+ *       "cross" edges: rank pairs {(1,2),(3,0)}
+ *     For rank r, peer (r+1)%4 is the pair edge when r is even and the
+ *     cross edge when r is odd; peer (r+3)%4 is always the other class.
+ *   - A device index is the position of the device in NCCL's net device
+ *     enumeration, i.e. the [i] column of the "NET/IB: [i] <name>" NCCL log
+ *     lines. When NCCL_IB_HCA is used, write it in that same order (the
+ *     natural system enumeration order), so HCA-list position == device
+ *     index. Every listed device must exist on every node.
+ *   - Both keys "pair" and "cross" must appear exactly once (either order).
+ *     Each key takes 1..4 device indices. Channel c of an edge uses
+ *     dev_list[c % n] of its class list (SR-4: with the intended n=2,
+ *     channels alternate across the two direct links of the edge).
+ *   - world_size != 4: bypassed with a single INFO line (choice made to
+ *     keep accidentally-exported variables from breaking other jobs).
+ *   - Any malformed value: WARN + init failure (ncclInvalidUsage), never a
+ *     silent fallback.
+ *************************************************************************/
+
+#include <stdlib.h>
+#include <string.h>
+
+#include "comm.h"
+#include "graph.h"
+#include "param.h"
+#include "topo.h"
+#include "transport.h"  // struct ncclPeerInfo
+
+#define NCCL_RING_EDGE_DEVS_ENV "NCCL_RING_EDGE_DEVS"
+#define NCCL_RING_MAX_DEVS 4
+
+// Edge classes over the ring order 0-1-2-3-0.
+#define NCCL_RING_EDGE_PAIR 0   // rank pairs {(0,1),(2,3)}
+#define NCCL_RING_EDGE_CROSS 1  // rank pairs {(1,2),(3,0)}
+
+static struct ncclRingEdgeDevs {
+  int valid;  // parsed OK and world size eligible
+  int ndevs[2];
+  int devs[2][NCCL_RING_MAX_DEVS];
+} gRing = {0, {0, 0}, {{0}}};
+
+static bool ncclRingAdjacent(int rank, int peer, int nRanks) {
+  return peer == (rank + 1) % nRanks || peer == (rank + nRanks - 1) % nRanks;
+}
+
+// Class of the (rank, peer) edge; caller must guarantee 4-rank adjacency.
+// Even ranks pair with their (+1) peer, odd ranks cross to it.
+static int ncclRingEdgeType(int rank, int peer) {
+  return (peer == (rank + 1) % 4) ? (rank & 1) : 1 - (rank & 1);
+}
+
+// Strictly parse "pair=d1,d2;cross=d3,d4" (key order free). Returns 0 on
+// success, -1 on any error.
+static int ncclRingParse(struct ncclRingEdgeDevs* m, const char* s) {
+  m->ndevs[0] = m->ndevs[1] = 0;
+  int seen[2] = {0, 0};
+  if (*s == '\0') return -1;
+  while (1) {
+    int type;
+    if (strncmp(s, "pair=", 5) == 0) {
+      type = NCCL_RING_EDGE_PAIR;
+      s += 5;
+    } else if (strncmp(s, "cross=", 6) == 0) {
+      type = NCCL_RING_EDGE_CROSS;
+      s += 6;
+    } else {
+      return -1;
+    }
+    if (seen[type]++) return -1;  // duplicate key
+    while (1) {
+      char* end;
+      long d = strtol(s, &end, 10);
+      if (end == s || d < 0 || d >= NCCL_TOPO_MAX_NODES || m->ndevs[type] >= NCCL_RING_MAX_DEVS) return -1;
+      m->devs[type][m->ndevs[type]++] = (int)d;
+      s = end;
+      if (*s != ',') break;
+      s++;
+    }
+    if (*s == '\0') break;
+    if (*s != ';') return -1;
+    s++;
+    if (*s == '\0') return -1;  // trailing ';'
+  }
+  return (seen[NCCL_RING_EDGE_PAIR] == 1 && seen[NCCL_RING_EDGE_CROSS] == 1) ? 0 : -1;
+}
+
+// Resolve a device index to its NET topology node id.
+static ncclResult_t ncclRingDevToNetId(struct ncclTopoSystem* system, int dev, int64_t* netId) {
+  for (int n = 0; n < system->nodes[NET].count; n++) {
+    if (system->nodes[NET].nodes[n].net.dev == dev) {
+      if (netId) *netId = system->nodes[NET].nodes[n].id;
+      return ncclSuccess;
+    }
+  }
+  WARN("NCCL_RING_EDGE_DEVS: device index %d does not exist (this node has %d net devices)", dev,
+       system->nodes[NET].count);
+  return ncclInvalidUsage;
+}
+
+// Called once per communicator after the topology is built (SR-3 entry point).
+ncclResult_t ncclRingPeerInit(struct ncclComm* comm) {
+  const char* val = ncclGetEnv(NCCL_RING_EDGE_DEVS_ENV);
+  gRing.valid = 0;
+  if (val == NULL || *val == '\0') return ncclSuccess;  // bypass: stock NCCL
+  if (comm->nRanks != 4) {
+    if (comm->rank == 0)
+      INFO(NCCL_ENV, "%s set but nRanks is %d (not 4); switchless-ring mode bypassed", NCCL_RING_EDGE_DEVS_ENV,
+           comm->nRanks);
+    return ncclSuccess;  // documented bypass
+  }
+  if (ncclRingParse(&gRing, val) != 0) {
+    WARN("Invalid %s \"%s\": expected \"pair=<dev>,<dev>;cross=<dev>,<dev>\" with both keys exactly once",
+         NCCL_RING_EDGE_DEVS_ENV, val);
+    return ncclInvalidUsage;
+  }
+  for (int t = 0; t < 2; t++)
+    for (int i = 0; i < gRing.ndevs[t]; i++)
+      NCCLCHECK(ncclRingDevToNetId(comm->topo, gRing.devs[t][i], NULL));  // fail init on bad device index
+  gRing.valid = 1;
+  int prev = (comm->rank + 3) % 4, next = (comm->rank + 1) % 4;
+  INFO(NCCL_INIT | NCCL_ENV, "Switchless-ring mode active on rank %d/4: rank %d edge is %s, rank %d edge is %s (%s)",
+       comm->rank, next, ncclRingEdgeType(comm->rank, next) == NCCL_RING_EDGE_PAIR ? "pair" : "cross", prev,
+       ncclRingEdgeType(comm->rank, prev) == NCCL_RING_EDGE_PAIR ? "pair" : "cross", val);
+  return ncclSuccess;
+}
+
+bool ncclRingPeerActive(struct ncclComm* comm) {
+  return gRing.valid && comm != NULL && comm->nRanks == 4;
+}
+
+// SR-1 enforcement: cross-node NET connections are allowed to ring neighbours only.
+ncclResult_t ncclRingPeerCheckPeer(struct ncclComm* comm, int peerRank) {
+  if (peerRank < 0 || peerRank >= comm->nRanks) return ncclSuccess;  // let callers handle invalid peers
+  if (comm->peerInfo[peerRank].hostHash == comm->peerInfo[comm->rank].hostHash) return ncclSuccess;  // intra-node
+  if (ncclRingAdjacent(comm->rank, peerRank, comm->nRanks)) return ncclSuccess;
+  WARN("Switchless-ring mode: refusing cross-node NET connection rank %d -> rank %d (not ring-adjacent)", comm->rank,
+       peerRank);
+  return ncclInvalidUsage;
+}
+
+// SR-2/SR-4: force the net device of (peerRank, channelId) to the edge-class
+// list. Callers run ncclRingPeerCheckPeer first, so peerRank is adjacent.
+ncclResult_t ncclRingPeerNetDev(struct ncclComm* comm, int peerRank, int channelId, int64_t* netId, int* netDev,
+                                int* proxyRank) {
+  if (comm->peerInfo[peerRank].hostHash == comm->peerInfo[comm->rank].hostHash) return ncclSuccess;  // intra-node
+  int type = ncclRingEdgeType(comm->rank, peerRank);
+  int dev = gRing.devs[type][channelId % gRing.ndevs[type]];
+  int64_t id;
+  NCCLCHECK(ncclRingDevToNetId(comm->topo, dev, &id));
+  if (netId) *netId = id;
+  if (netDev) *netDev = dev;
+  if (proxyRank) NCCLCHECK(ncclTopoGetIntermediateRank(comm->topo, comm->rank, id, proxyRank));
+  return ncclSuccess;
+}
