# DS4.1-Flash 四机无交换机环 — 本现场配置
# 由社区配方（MiaAI/knapcio）适配本仓库双 rail 环拓扑。复制为 .env.tp4 后按 docs/cookbook.zh-CN.md §6 填写。
#
# 与上游 .env.tp4.example 的差异（都是有意的）：
#   * 群组地址全用管理网 <MGMT_SUBNET>.x（环上 4 台不全互联，rendezvous 走交换机所以能全覆盖）
#   * IB_HCA 指定本节点两个“邻居口”（cross rail + pair rail），不是上游的 rocep1s0f0/f1
#   * NCCL_ALGO=Ring + IB 子网感知路由（环拓扑约束下必须）
#   * NFS_SHARE=0：权重每台本机自持，worker 用 bind 到本地目录的 docker volume
#   * NCCL_HOST_DIR 指向补丁版 NCCL

# ─── cluster ──────────────────────────────────────────────────────────────────
HEAD_IP=<HEAD_IP>
WORKER_IPS="<WORKER_IP_1> <WORKER_IP_2> <WORKER_IP_3>"
WORKER_HOSTS="<WORKER_IP_1> <WORKER_IP_2> <WORKER_IP_3>"
WORKER_USER=hi
SSH_IDENTITY=$HOME/.ssh/id_ed25519

# ─── fabric: 无交换机环 ────────────────────────────────────────────────────────
# 环序 0-1(pair,f1) / 1-2(cross,f0) / 2-3(pair,f1) / 3-0(cross,f0)
# 每条边一个独立 /24，NCCL 才能按子网选到“直连的那个邻居口”
#   node0: pair 10.10.10.1  cross 10.10.40.1
#   node1: pair 10.10.10.2  cross 10.10.20.2
#   node2: pair 10.10.30.3  cross 10.10.20.3
#   node3: pair 10.10.30.4  cross 10.10.40.4
FABRIC_IFACE=enp1s0f1np1
GLOO_SOCKET_IFNAME=enP7s7
NCCL_SOCKET_IFNAME=enP7s7
IB_HCA=rocep1s0f0,rocep1s0f1,roceP2p1s0f0,roceP2p1s0f1
NCCL_NET=IB
NCCL_IB_DISABLE=0
NCCL_P2P_DISABLE=1
NCCL_SHM_DISABLE=1
NCCL_DEBUG=WARN
NCCL_DEBUG_SUBSYS=INIT,ENV
NCCL_BUFFSIZE=1048576
NCCL_LL128_BUFFSIZE=262144
NCCL_PROTO=LL,LL128,Simple
NCCL_MAX_NCHANNELS=4
NCCL_CROSS_NIC=1
NCCL_IB_MERGE_NICS=0
NCCL_IB_SUBNET_AWARE_ROUTING=1
NCCL_IB_SUBNET_PREFIX_LEN=24
# 环模式（补丁版 NCCL 才有这两个开关）
NCCL_ALGO=Ring


NCCL_CUMEM_ENABLE=0
# ring-nccl 补丁库（构建与部署见 docs/cookbook.zh-CN.md §3）
NCCL_HOST_DIR=/opt/ring-nccl

# ─── model / image ────────────────────────────────────────────────────────────
MODEL_DIR=$HOME/NewModels/DeepSeek-V4.1-Flash
COMMON_MODEL=/var/tmp/DeepSeek-V4.1-Flash
BASE_IMAGE=m.daocloud.io/docker.io/lmsysorg/sglang:dev-dsv41
IMAGE=dsv41-4x-spark:canary
PORT=8888

# ─── weights: 本机自持，不走 NFS ───────────────────────────────────────────────
NFS_SHARE=0
NFS_VOLUME=dsv41-weights
NFS_EXPORT_NAME=dsv41-native
NFS_SERVER_IPS="<HEAD_IP>"
NFS_CLIENTS=<MGMT_SUBNET>.0/24

# ─── parallelism ──────────────────────────────────────────────────────────────
NNODES=4
TP_SIZE=4
EP_SIZE=2
DIST_PORT=20000

# ─── serving（沿用上游 TP4 profile，除非有理由不动） ────────────────────────────
OFFLOAD_MODE=nvme
DSV41_CACHE_GIB=4
DSV41_IO_THREADS=96
DSV41_RESIDENT_SCALES=0
DSV41_CACHE_WAYS=16
DSV41_STATS_SECONDS=60
CONTEXT_LENGTH=1048576
MEM_FRACTION_STATIC=0.80
HEAD_MEM_FRACTION_STATIC=0.80
MAX_RUNNING_REQUESTS=16
CHUNKED_PREFILL_SIZE=4096
MAX_TOTAL_TOKENS=8000000
SPEC_ALGO=DSPARK
DSPARK_BLOCK_SIZE=3
DSPARK_SPS_TABLE=/state/dspark_sps.json
DSPARK_STS_TABLE=/state/dspark_sts.json

# ─── engram local shards ──────────────────────────────────────────────────────
ENGRAM_DIR=$HOME/dsv41-engram
DSV41_PACKED_DIR=/engram
SKIP_PREPARE=1
SKIP_VERIFY=1
SKIP_SMOKE=0
SMOKE_QUICK=1

# ─── kernels (GB10 / SM121) ───────────────────────────────────────────────────
EXTRA_SGLANG_ARGS='--fp8-gemm-backend flashinfer_cutlass --watchdog-timeout 1800 --min-free-slots-delay 1'
DSV41_MXFP8_BACKEND=b12x
SGLANG_FLASHINFER_MOE_FUSED_FINALIZE=0
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:False
DSV41_PREFILL_EMPTY_CACHE_TOKENS=8192

# ─── TP4 runtime ──────────────────────────────────────────────────────────────
DSV41_TP_PAD=0
WORKER_DIR=/home/$WORKER_USER/dsv41-4x-spark
# ─── 环配方增补（alexellis FIXED RECIPE，2026-09-16 验收通过）───
NCCL_IB_GID_INDEX=3
NCCL_MIN_NCHANNELS=4
NCCL_P2P_LEVEL=SYS
NCCL_IGNORE_CPU_AFFINITY=1

# --- 2026-09-16 同步上游 79f656a（PR#18 serving 加固）新增 ---
# thinking 请求未带 reasoning_effort 时的默认预算（出版方口径 low/high/max=50/75/100）
SGLANG_DSV41_REASONING_EFFORT=75
# 聊天请求缺 max_tokens 时的填充与硬上限（0 = 恢复填满剩余上下文行为）
DSV41_MAX_NEW_TOKENS=32768
# 解码侧死循环熔断（n-gram 循环/同 token 连打/同行重复），0 关闭
DSV41_LOOP_ABORT=1
DSV41_LOOP_NGRAM=32
DSV41_LOOP_REPEATS=4
DSV41_LOOP_LINE_REPEATS=8
DSV41_SHARED_PAD_K=1
EXTRA_DOCKER_ENV="SPARK_PREFILL_TP_SPLIT=1 SPARK_PREFILL_TP_MIN_CONTEXT=32768 SPARK_PREFILL_TP_MIN_ROWS=1024 DSV41_INDEXER_CHUNKED=1 SGLANG_DSPARK_FOLDED_SAMPLING=2 SGLANG_RUST_BUILD_MODE=never RUSTUP_HOME=/nonexistent-rustup NCCL_RING_EDGE_DEVS=pair=1,3;cross=0,2"
